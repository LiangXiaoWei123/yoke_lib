menu "yoke_screen"

menu "Screen"

config YOKE_BSP_SCREEN_LVGL_DRAW_BUFFER_IN_PSRAM
    bool "Allocate LVGL draw buffers in PSRAM"
    default y
    depends on SPIRAM && SOC_PSRAM_DMA_CAPABLE
    help
        Store the large LVGL draw buffers in PSRAM. The ST7789 SPI path uses
        DMA, so this option is available only on targets whose PSRAM is DMA
        capable. Disable it to allocate the buffers in internal SRAM instead.

config YOKE_BSP_SCREEN_LVGL_TASK_STACK_IN_PSRAM
    bool "Allocate LVGL task stack in PSRAM"
    default n
    depends on SPIRAM && FREERTOS_TASK_CREATE_ALLOW_EXT_MEM
    help
        Store the LVGL task stack in PSRAM to preserve internal SRAM. Keep
        this disabled when the task may execute code that requires an
        internal-memory stack while cache is disabled.

endmenu

endmenu
